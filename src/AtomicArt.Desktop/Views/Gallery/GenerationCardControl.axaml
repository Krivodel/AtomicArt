<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="https://codewf.com"
             xmlns:controls="using:AtomicArt.Desktop.Views.Gallery"
             xmlns:gallery="using:AtomicArt.Desktop.ViewModels.Gallery"
             xmlns:resources="using:AtomicArt.Desktop.Resources"
             xmlns:uiControls="using:AtomicArt.Desktop.Controls"
             x:Class="AtomicArt.Desktop.Views.Gallery.GenerationCardControl"
             x:Name="GenerationCard"
             x:DataType="gallery:GenerationItemViewModel">
    <Border x:Name="GenerationCardContainer"
            Classes="generation-card-container">
        <Border.ContextFlyout>
            <uiControls:AnimatedContextMenuFlyout>
                <MenuItem x:Name="SelectMenuItem"
                          Classes="selection-context-menu-item"
                          IsEnabled="{Binding !IsSelected}"
                          Command="{Binding #GenerationCard.ToggleSelectionCommand}"
                          CommandParameter="{Binding #GenerationCard.DataContext}">
                    <MenuItem.Header>
                        <TextBlock Classes="context-menu-item-header"
                                   Text="{i18n:I18n {x:Static resources:GalleryLocalizationKeys+Actions.Select}}" />
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <Path Classes="gallery-selection-check" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="ShowInFolderMenuItem"
                          Command="{Binding #GenerationCard.RevealInFolderCommand}"
                          CommandParameter="{Binding #GenerationCard.DataContext}">
                    <MenuItem.Header>
                        <TextBlock Classes="context-menu-item-header"
                                   Text="{i18n:I18n {x:Static resources:GalleryLocalizationKeys+Actions.ShowInFolder}}" />
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource GalleryFolderIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="ImbaMenuItem">
                    <MenuItem.Header>
                        <TextBlock Classes="context-menu-item-header"
                                   Text="{i18n:I18n {x:Static resources:GalleryLocalizationKeys+Actions.Imba}}" />
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource GalleryImbaIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="DeleteMenuItem"
                          Command="{Binding #GenerationCard.DeleteOrCancelCommand}"
                          CommandParameter="{Binding #GenerationCard.DataContext}">
                    <MenuItem.Header>
                        <TextBlock Classes="context-menu-item-header"
                                   Text="{i18n:I18n {x:Static resources:GalleryLocalizationKeys.ConfirmDeletion}}" />
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <PathIcon Classes="Danger"
                                  Data="{StaticResource GalleryDeleteIcon}" />
                    </MenuItem.Icon>
                </MenuItem>
            </uiControls:AnimatedContextMenuFlyout>
        </Border.ContextFlyout>

        <Border x:Name="GenerationCardRoot"
                Classes="generation-card">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource GenerationCardPreviewHeight}" />
                    <RowDefinition Height="{StaticResource GenerationCardInfoHeight}" />
                </Grid.RowDefinitions>

                <controls:GenerationPreviewControl x:Name="GenerationPreview"
                                                   Grid.Row="0"
                                                   PreviewSize="{StaticResource GenerationCardWidth}"
                                                   PreviewPath="{Binding DisplayThumbnailPath}"
                                                   OpenViewerCommand="{Binding $parent[controls:GenerationCardControl].OpenViewerCommand}"
                                                   ShowFailureDetailsCommand="{Binding $parent[controls:GenerationCardControl].ShowFailureDetailsCommand}" />

                <Border Grid.Row="1"
                        Classes="generation-card-info">
                    <Grid RowDefinitions="*,Auto">
                        <uiControls:OverflowEllipsisTextBlock Grid.Row="0"
                                                              Classes="generation-card-prompt"
                                                              Text="{Binding Prompt}" />
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Classes="generation-card-model"
                                       Text="{Binding ModelDisplayName}" />
                            <TextBlock Grid.Column="1"
                                       Classes="generation-card-time"
                                       Text="{Binding ElapsedText}" />
                        </Grid>
                    </Grid>
                </Border>

                <Button x:Name="PromptDragSource"
                        Grid.Row="1"
                        Classes="card-zone-hit-target"
                        IsVisible="{Binding !$parent[controls:GenerationCardControl].IsSelectionMode}"
                        Click="OnPromptDragSourceClick"
                        Cursor="Arrow" />

                <Border x:Name="SelectionDimmingOverlay"
                        Grid.RowSpan="2"
                        ZIndex="10"
                        Classes="gallery-selection-dimming-overlay" />

                <Border x:Name="SelectionHighlight"
                        Grid.RowSpan="2"
                        ZIndex="15"
                        Classes="gallery-selection-highlight"
                        Classes.selected="{Binding IsSelected}" />

                <Button x:Name="RevealInFolderButton"
                        Grid.Row="0"
                        ZIndex="20"
                        Margin="{StaticResource GalleryCardActionMargin}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Classes="Icon card-action card-action-left"
                        IsVisible="{Binding !$parent[controls:GenerationCardControl].IsSelectionMode}"
                        Click="OnRevealInFolderClick">
                    <PathIcon Classes="card-action-icon"
                              Data="{StaticResource GalleryFolderIcon}" />
                </Button>

                <Button x:Name="ToggleSelectionButton"
                        Grid.Row="0"
                        ZIndex="20"
                        Margin="{StaticResource GalleryCardActionMargin}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="Icon card-action card-action-right card-selection-toggle"
                        Classes.selected="{Binding IsSelected}"
                        Focusable="{Binding !$parent[controls:GenerationCardControl].IsSelectionMode}"
                        IsHitTestVisible="{Binding !$parent[controls:GenerationCardControl].IsSelectionMode}"
                        Click="OnSelectionClick">
                    <Path Classes="gallery-selection-check" />
                </Button>

                <Button Grid.RowSpan="2"
                        ZIndex="30"
                        Classes="card-zone-hit-target"
                        IsVisible="{Binding $parent[controls:GenerationCardControl].IsSelectionMode}"
                        Click="OnSelectionClick" />
            </Grid>
        </Border>
    </Border>
</UserControl>
