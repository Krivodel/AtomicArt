<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:AtomicArt.Desktop.Controls"
             xmlns:gallery="using:AtomicArt.Desktop.ViewModels.Gallery"
             xmlns:generation="using:AtomicArt.Desktop.Controls.Generation"
             xmlns:i18n="https://codewf.com"
             xmlns:resources="using:AtomicArt.Desktop.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomicArt.Desktop.Views.Gallery.GenerationPreviewControl"
             x:Name="Root"
             x:DataType="gallery:GenerationItemViewModel"
             ClipToBounds="False"
             ZIndex="10">
    <Grid Width="{Binding #Root.PreviewSize}"
          Height="{Binding #Root.PreviewSize}"
          ClipToBounds="False">
        <Grid x:Name="PreviewExpansionHost"
              Width="{Binding #Root.PreviewSize, Priority=Style}"
              Height="{Binding #Root.PreviewSize, Priority=Style}"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              ZIndex="10">
            <Border x:Name="PreviewShadow"
                    Classes="image-preview-shadow"
                    Background="{DynamicResource SukiPopupBackground}"
                    CornerRadius="{StaticResource GenerationCardCornerRadius}"
                    Opacity="0" />
            <Border Classes="generation-card-preview"
                    CornerRadius="{StaticResource GenerationCardCornerRadius}">
                <Image x:Name="PreviewImage"
                       Classes="generation-card-image"
                       IsVisible="{Binding ShowsGeneratedImage}"
                       RenderOptions.BitmapInterpolationMode="MediumQuality" />
            </Border>
        </Grid>

        <generation:AttachmentPixelLoadingControl x:Name="PixelLoadingIndicator"
                                                  GridSize="{StaticResource GenerationPixelLoadingGridSize}"
                                                  AnimationSeed="{Binding Id}"
                                                  IsActive="{Binding ShowsGenerationProgress}" />

        <Border Classes="generation-card-empty"
                IsVisible="{Binding ShowsEmptyPreview}">
            <ContentControl HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Content="{Binding TextReplyPreview}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type x:String}"
                                  x:DataType="x:String">
                        <Grid Margin="{StaticResource GalleryCardInfoPadding}"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="{StaticResource GenerationChatItemSpacing}">
                            <Path HorizontalAlignment="Left"
                                  Classes="metadata-outline-icon"
                                  Data="{StaticResource AppChatIcon}"
                                  Stroke="{StaticResource MetadataSecondaryTextBrush}" />
                            <controls:OverflowEllipsisTextBlock Grid.Row="1"
                                                               Classes="generation-card-prompt"
                                                               Text="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

        <Border x:Name="FailurePreview"
                Classes="generation-card-error"
                IsVisible="{Binding IsFailed}"
                Cursor="Hand"
                PointerReleased="OnFailurePreviewPointerReleased">
            <TextBlock Classes="generation-card-error-text"
                       Text="{i18n:I18n {x:Static resources:CommonLocalizationKeys.Error}}" />
        </Border>

        <Border x:Name="PreviewDragSource"
                IsVisible="{Binding !IsFailed}"
                Background="Transparent"
                Cursor="Hand"
                PointerCaptureLost="OnPreviewDragSourcePointerCaptureLost"
                PointerMoved="OnPreviewDragSourcePointerMoved"
                PointerPressed="OnPreviewDragSourcePointerPressed"
                PointerReleased="OnPreviewDragSourcePointerReleased" />
    </Grid>
</UserControl>
