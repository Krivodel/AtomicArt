<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:AtomicArt.Desktop.Behaviors"
             xmlns:controls="using:AtomicArt.Desktop.Controls.Settings"
             xmlns:settings="using:AtomicArt.Desktop.ViewModels.Settings"
             x:Class="AtomicArt.Desktop.Views.Settings.LanguageSettingView"
             x:DataType="settings:LanguageSettingViewModel">
    <controls:SettingItemControl>
        <controls:SettingItemControl.Editor>
            <ComboBox IsEnabled="{Binding !IsLoading}"
                      behaviors:ComboBoxSearchBehavior.IsEnabled="True"
                      behaviors:ComboBoxSearchBehavior.PlaceholderText="{Binding SearchPlaceholder}"
                      behaviors:ComboBoxSearchBehavior.Text="{Binding SearchText, Mode=TwoWay}"
                      DropDownClosed="OnDropDownClosed"
                      DropDownOpened="OnDropDownOpened"
                      ItemsSource="{Binding Options}"
                      SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="settings:LanguageOptionViewModel">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingItemControl.Editor>
    </controls:SettingItemControl>
</UserControl>
