<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:AtomicArt.Desktop.ViewModels.Settings"
             x:Class="AtomicArt.Desktop.Views.Settings.BooleanSettingView"
             x:DataType="settings:BooleanSettingViewModel">
    <Grid RowDefinitions="Auto,Auto">
        <CheckBox Classes="settings-label"
                  IsEnabled="{Binding !IsLoading}"
                  Content="{Binding DisplayName}"
                  IsChecked="{Binding IsChecked, Mode=TwoWay}" />
        <TextBlock Grid.Row="1"
                   Margin="{StaticResource SettingsErrorMargin}"
                   Classes="error-message danger-text"
                   IsVisible="{Binding HasErrorMessage}"
                   Text="{Binding ErrorMessage}" />
    </Grid>
</UserControl>
