<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AtomicArt.Desktop.Controls.Settings"
             xmlns:settings="using:AtomicArt.Desktop.ViewModels.Settings"
             x:Class="AtomicArt.Desktop.Views.Settings.BooleanSettingView"
             x:DataType="settings:BooleanSettingViewModel">
    <controls:SettingItemControl>
        <controls:SettingItemControl.Header>
            <CheckBox Classes="settings-switch"
                      IsEnabled="{Binding !IsLoading}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay}">
                <TextBlock Classes="settings-label"
                           TextWrapping="Wrap"
                           Text="{Binding DisplayName}" />
            </CheckBox>
        </controls:SettingItemControl.Header>
    </controls:SettingItemControl>
</UserControl>
