<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AtomicArt.Desktop.Controls.Settings"
             xmlns:settings="using:AtomicArt.Desktop.ViewModels.Settings"
             x:Class="AtomicArt.Desktop.Views.Settings.DataRootSettingView"
             x:DataType="settings:DataRootSettingViewModel">
    <controls:SettingItemControl>
        <controls:SettingItemControl.Editor>
            <StackPanel Spacing="{StaticResource SmallSpacing}">
                <TextBox IsReadOnly="True"
                         Text="{Binding Value}" />
                <TextBlock Classes="metadata-value"
                           TextWrapping="Wrap"
                           Text="{Binding Description}" />
                <ProgressBar IsIndeterminate="{Binding IsProgressIndeterminate}"
                             IsVisible="{Binding IsLoading}"
                             Maximum="100"
                             Value="{Binding ProgressPercentage}" />
                <TextBlock Classes="metadata-value"
                           IsVisible="{Binding IsLoading}"
                           Text="{Binding ProgressText}" />
            </StackPanel>
        </controls:SettingItemControl.Editor>
    </controls:SettingItemControl>
</UserControl>
