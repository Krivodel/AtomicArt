<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="https://codewf.com"
             xmlns:dialogs="using:AtomicArt.Desktop.ViewModels.Dialogs"
             xmlns:overlays="using:AtomicArt.Desktop.Controls.Overlays"
             xmlns:resources="using:AtomicArt.Desktop.Resources"
             x:Class="AtomicArt.Desktop.Views.Dialogs.ErrorDialogOverlayView"
             x:DataType="dialogs:ErrorDialogViewModel">
    <overlays:ModalOverlayControl Width="{StaticResource DialogOverlayWidth}"
                                  Title="{i18n:I18n {x:Static resources:CommonLocalizationKeys.Error}}"
                                  CloseCommand="{Binding CloseCommand}">
        <overlays:ModalOverlayControl.Body>
            <StackPanel Margin="{StaticResource DialogContentMargin}"
                        Spacing="{StaticResource DialogContentSpacing}">
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding Message}" />
                <Button MinWidth="{StaticResource DialogActionButtonMinWidth}"
                        HorizontalAlignment="Right"
                        Content="{i18n:I18n {x:Static resources:CommonLocalizationKeys.Copy}}"
                        Command="{Binding CopyCommand}" />
            </StackPanel>
        </overlays:ModalOverlayControl.Body>
    </overlays:ModalOverlayControl>
</UserControl>
