<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:AtomicArt.Desktop.ViewModels.Dialogs"
             xmlns:overlays="using:AtomicArt.Desktop.Controls.Overlays"
             xmlns:resources="using:AtomicArt.Desktop.Resources"
             x:Class="AtomicArt.Desktop.Views.Dialogs.ErrorDialogOverlayView"
             x:DataType="dialogs:ErrorDialogViewModel">
    <overlays:ModalOverlayControl Width="{StaticResource ErrorDialogOverlayWidth}"
                                  Title="{x:Static resources:UiStrings.Error}"
                                  CloseCommand="{Binding CloseCommand}">
        <overlays:ModalOverlayControl.Body>
            <StackPanel Margin="{StaticResource ErrorDialogContentMargin}"
                        Spacing="{StaticResource ErrorDialogContentSpacing}">
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding Message}" />
                <Button MinWidth="{StaticResource ErrorDialogActionButtonMinWidth}"
                        HorizontalAlignment="Right"
                        Content="{x:Static resources:UiStrings.Copy}"
                        Command="{Binding CopyCommand}" />
            </StackPanel>
        </overlays:ModalOverlayControl.Body>
    </overlays:ModalOverlayControl>
</UserControl>
