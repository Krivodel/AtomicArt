<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="https://codewf.com"
             xmlns:dialogs="using:AtomicArt.Desktop.ViewModels.Dialogs"
             xmlns:overlays="using:AtomicArt.Desktop.Controls.Overlays"
             xmlns:resources="using:AtomicArt.Desktop.Resources"
             x:Class="AtomicArt.Desktop.Views.Dialogs.ConfirmationDialogOverlayView"
             x:DataType="dialogs:ConfirmationDialogViewModel">
    <overlays:ModalOverlayControl Width="{StaticResource DialogOverlayWidth}"
                                  Title="{Binding Title}"
                                  CloseCommand="{Binding CancelCommand}">
        <overlays:ModalOverlayControl.Body>
            <StackPanel Margin="{StaticResource DialogContentMargin}"
                        Spacing="{StaticResource DialogContentSpacing}">
                <TextBlock TextWrapping="Wrap"
                           Text="{Binding Message}" />
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="12">
                    <Button MinWidth="{StaticResource DialogActionButtonMinWidth}"
                            Content="{i18n:I18n {x:Static resources:CommonLocalizationKeys.Cancel}}"
                            Command="{Binding CancelCommand}" />
                    <Button MinWidth="{StaticResource DialogActionButtonMinWidth}"
                            Classes="danger"
                            Content="{Binding ConfirmActionText}"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </StackPanel>
        </overlays:ModalOverlayControl.Body>
    </overlays:ModalOverlayControl>
</UserControl>
