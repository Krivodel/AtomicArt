<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:behaviors="using:AtomicArt.Desktop.Behaviors"
             xmlns:codex="using:AtomicArt.Desktop.Services.Generation.LocalCodex"
             xmlns:contracts="using:AtomicArt.Contracts.Generation"
             xmlns:controls="using:AtomicArt.Desktop.Controls.Generation"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:generation="using:AtomicArt.Desktop.ViewModels.Generation"
             xmlns:i18n="https://codewf.com"
             xmlns:models="using:AtomicArt.Desktop.Services"
             xmlns:resources="using:AtomicArt.Desktop.Resources"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:views="using:AtomicArt.Desktop.Views.Generation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomicArt.Desktop.Views.Generation.NanoBanana2PanelView"
             x:DataType="generation:UniversalNanoBananaPanelViewModel">
    <Grid x:Name="PanelRoot">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <Grid x:Name="GenerationParametersRow"
                  Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                <ComboBox Grid.Column="0"
                          MinWidth="{StaticResource GenerationModelComboMinWidth}"
                          Margin="-5,0,0,0"
                          HorizontalAlignment="Left"
                          IsEnabled="{Binding HasLoadedCatalog}"
                          ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ImageModelOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox x:Name="AspectRatioComboBox"
                          Grid.Column="1"
                          MinWidth="{StaticResource GenerationOptionComboMinWidth}"
                          IsEnabled="{Binding HasLoadedCatalog}"
                          ContainerClearing="OnAspectRatioContainerClearing"
                          ContainerPrepared="OnAspectRatioContainerPrepared"
                          DropDownClosed="OnAspectRatioDropDownClosed"
                          DropDownOpened="OnAspectRatioDropDownOpened"
                          ItemsSource="{Binding AspectRatioOptions}"
                          SelectedItem="{Binding SelectedAspectRatioOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="generation:GenerationOptionViewModel">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="2"
                            IsVisible="{Binding IsLocalCodexSelected}"
                            Orientation="Horizontal"
                            Spacing="8">
                    <ComboBox MinWidth="{StaticResource GenerationOptionComboMinWidth}"
                              AutomationProperties.Name="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Thinking.TextModel}}"
                              PlaceholderText="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Thinking.TextModel}}"
                              ItemsSource="{Binding CodexTextModels}"
                              SelectedItem="{Binding SelectedCodexTextModel}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="codex:LocalCodexTextModel">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <controls:GenerationOptionSelector x:Name="CodexReasoningSelector"
                                                       ResetButtonName="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Thinking.Label}}"
                                                       ResetIcon="{StaticResource AppBrainIcon}"
                                                       ResetCommand="{Binding ResetThinkingLevelCommand}">
                        <controls:GenerationOptionSelector.Selector>
                            <ComboBox MinWidth="{StaticResource GenerationOptionComboMinWidth}"
                                      AutomationProperties.Name="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Thinking.Label}}"
                                      PlaceholderText="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Thinking.Label}}"
                                      ItemsSource="{Binding CodexReasoningEfforts}"
                                      SelectedItem="{Binding SelectedCodexReasoningEffort}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="generation:GenerationOptionViewModel">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:GenerationOptionSelector.Selector>
                    </controls:GenerationOptionSelector>
                </StackPanel>

                <ComboBox x:Name="ResolutionComboBox"
                          Grid.Column="2"
                          MinWidth="{StaticResource GenerationOptionComboMinWidth}"
                          IsVisible="{Binding !IsLocalCodexSelected}"
                          IsEnabled="{Binding HasLoadedCatalog}"
                          ItemsSource="{Binding Resolutions}"
                          SelectedItem="{Binding SelectedResolution}" />

                <Grid x:Name="GenerationOptionsSlot"
                      Grid.Column="3"
                      Margin="{StaticResource GenerationAdvancedOptionsMargin}"
                      IsVisible="{Binding !IsLocalCodexSelected}"
                      ClipToBounds="True">
                    <Border x:Name="GenerationSettingsButtonHost"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Button x:Name="TemperatureButton"
                                Classes="Icon generation-option"
                                IsEnabled="{Binding HasLoadedCatalog}"
                                Click="OnTemperatureButtonClick">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                    <Binding Path="SupportsGenerationOptions" />
                                    <Binding ElementName="InlineGenerationOptionsHost"
                                             Path="!IsHitTestVisible" />
                                </MultiBinding>
                            </Button.IsVisible>
                            <PathIcon Data="{StaticResource AppSettingsIcon}" />
                        </Button>
                    </Border>

                    <ContentControl x:Name="InlineGenerationOptionsHost"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Left"
                                    IsVisible="False"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False" />
                </Grid>

                <Popup x:Name="TemperaturePopup"
                       Grid.Column="3"
                       IsVisible="{Binding SupportsGenerationOptions}"
                       Closed="OnTemperaturePopupClosed"
                       InheritsTransform="True"
                       IsLightDismissEnabled="False"
                       Opened="OnTemperaturePopupOpened"
                       Placement="Bottom"
                       PlacementTarget="{Binding #TemperatureButton}">
                    <ThemeVariantScope RequestedThemeVariant="{Binding #PanelRoot.ActualThemeVariant}">
                        <FlyoutPresenter Padding="0">
                            <Border x:Name="TemperatureFlyoutPanel"
                                    Padding="12"
                                    Background="{DynamicResource SukiPopupBackground}"
                                    BorderBrush="{DynamicResource SukiMenuBorderBrush}"
                                    BorderThickness="{StaticResource ShellBorderThickness}"
                                    BoxShadow="{DynamicResource SukiPopupShadow}"
                                    CornerRadius="{StaticResource OverlayCornerRadius}"
                                    Opacity="0">
                                <StackPanel x:Name="GenerationOptionsPanel"
                                            Classes="generation-advanced-options"
                                            Spacing="12">
                                    <Grid VerticalAlignment="Center"
                                          IsVisible="{Binding SupportsTemperature}"
                                          ColumnDefinitions="Auto,Auto,*"
                                          RowDefinitions="Auto,Auto">
                                        <Button Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.RowSpan="2"
                                                Classes="generation-option-reset"
                                                Theme="{StaticResource GenerationOptionResetButtonTheme}"
                                                Command="{Binding ResetTemperatureCommand}">
                                            <PathIcon Data="{StaticResource AppTemperatureIcon}" />
                                        </Button>
                                        <TextBlock Grid.Row="0"
                                                   HorizontalAlignment="Center"
                                                   Classes="panel-label generation-temperature-value"
                                                   Text="{Binding TemperatureText}" />
                                        <Slider x:Name="TemperatureSlider"
                                                Grid.Column="2"
                                                IsSnapToTickEnabled="True"
                                                LargeChange="{Binding TemperatureStep}"
                                                Maximum="{Binding MaximumTemperature}"
                                                Minimum="{Binding MinimumTemperature}"
                                                SmallChange="{Binding TemperatureStep}"
                                                TickFrequency="{Binding TemperatureStep}"
                                                Value="{Binding Temperature, Mode=TwoWay}" />
                                    </Grid>
                                    <controls:GenerationOptionSelector IsVisible="{Binding SupportsQuality}"
                                                                       ResetIcon="{StaticResource AppQualityIcon}"
                                                                       ResetCommand="{Binding ResetQualityCommand}">
                                        <controls:GenerationOptionSelector.Selector>
                                            <ComboBox x:Name="QualityComboBox"
                                                      HorizontalAlignment="Stretch"
                                                      Classes.gpt-quality="{Binding UsesGptImageQuality}"
                                                      AutomationProperties.Name="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Quality.Label}}"
                                                      MaxDropDownHeight="300"
                                                      ItemsSource="{Binding QualityLevels}"
                                                      SelectedItem="{Binding SelectedQualityOption, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="generation:GenerationOptionViewModel">
                                                        <TextBlock Classes="quality-option"
                                                                   Tag="{Binding Value}"
                                                                   Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </controls:GenerationOptionSelector.Selector>
                                    </controls:GenerationOptionSelector>
                                    <controls:GenerationOptionSelector IsVisible="{Binding SupportsComplexity}"
                                                                       ResetButtonName="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Complexity.Label}}"
                                                                       ResetIcon="{StaticResource AppBrainIcon}"
                                                                       ResetCommand="{Binding ResetComplexityCommand}">
                                        <controls:GenerationOptionSelector.Selector>
                                            <ComboBox x:Name="ComplexityComboBox"
                                                      HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Complexity.Label}}"
                                                      ItemsSource="{Binding ComplexityLevels}"
                                                      SelectedItem="{Binding SelectedComplexityOption, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="generation:GenerationOptionViewModel">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </controls:GenerationOptionSelector.Selector>
                                    </controls:GenerationOptionSelector>
                                    <controls:GenerationOptionSelector IsVisible="{Binding SupportsThinkingLevel}"
                                                                       ResetIcon="{StaticResource AppBrainIcon}"
                                                                       ResetCommand="{Binding ResetThinkingLevelCommand}">
                                        <controls:GenerationOptionSelector.Selector>
                                            <ComboBox x:Name="ThinkingLevelComboBox"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding ThinkingLevels}"
                                                      SelectedItem="{Binding SelectedThinkingLevel}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="contracts:GenerationModelThinkingLevelMetadataDto">
                                                        <TextBlock Text="{i18n:I18n {Binding LocalizationKey}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </controls:GenerationOptionSelector.Selector>
                                    </controls:GenerationOptionSelector>
                                </StackPanel>
                            </Border>
                        </FlyoutPresenter>
                    </ThemeVariantScope>
                </Popup>

                <ComboBox x:Name="GenerationCountComboBox"
                          Grid.Column="4"
                          MaxWidth="{StaticResource GenerationOptionComboMinWidth}"
                          Margin="0,0,-5,0"
                          HorizontalAlignment="Right"
                          IsEnabled="{Binding HasLoadedCatalog}"
                          ItemsSource="{Binding GenerationCounts}"
                          SelectedItem="{Binding GenerationCount}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="system:Int32">
                            <TextBlock Text="{Binding StringFormat='x{0}'}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <views:GenerationAttachmentStripView Grid.Row="1"
                                                 Margin="{StaticResource GenerationPanelInnerSpacing}" />

            <TextBox x:Name="PromptTextBox"
                     Grid.Row="2"
                     MinHeight="{StaticResource PromptHeight}"
                     Margin="{StaticResource GenerationPanelInnerSpacing}"
                     VerticalContentAlignment="Top"
                     Classes="prompt-input"
                     IsEnabled="{Binding HasLoadedCatalog}"
                     AcceptsReturn="True"
                     LostFocus="OnPromptLostFocus"
                     PlaceholderText="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Prompt.Placeholder}}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     behaviors:ClipboardPasteBehavior.IsEnabled="True"
                     FontSize="{Binding PromptTextSize}"
                     Text="{Binding Prompt}"
                     behaviors:TextBoxFocusBehavior.AutoFocus="{Binding HasLoadedCatalog}"
                     behaviors:TextSizeWheelBehavior.AdjustCommand="{Binding AdjustPromptTextSizeCommand}" />

            <TextBlock Grid.Row="3"
                       Margin="{StaticResource GenerationPanelInnerSpacing}"
                       Classes="error-message danger-text"
                       IsVisible="{Binding HasErrorMessage}"
                       Text="{Binding ErrorMessage}" />

            <Grid Grid.Row="4"
                  Margin="{StaticResource GenerationPanelInnerSpacing}"
                  ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Content="{Binding GenerateButtonText}"
                        Command="{Binding GenerateCommand}" />
                <Button Grid.Column="1"
                        Margin="{StaticResource AttachmentListMargin}"
                        IsVisible="{Binding RequiresChatBranchSelection}"
                        Content="{i18n:I18n {x:Static resources:GenerationChatLocalizationKeys.AddVariants}}"
                        Command="{Binding AddVariantsCommand}" />
                <Button Grid.Column="2"
                        Width="{StaticResource GenerationOptionButtonSize}"
                        Height="{StaticResource GenerationOptionButtonSize}"
                        Margin="{StaticResource AttachmentListMargin}"
                        VerticalAlignment="Stretch"
                        Classes="Icon"
                        IsVisible="{Binding Chat.HasChat, FallbackValue=False}"
                        AutomationProperties.Name="{i18n:I18n {x:Static resources:GenerationChatLocalizationKeys.History}}"
                        Command="{Binding Chat.ToggleCommand}"
                        behaviors:DragHoverBehavior.Command="{Binding Chat.ExpandCommand}">
                    <Path Classes="metadata-outline-icon"
                          Data="{StaticResource AppChatIcon}" />
                </Button>
            </Grid>
        </Grid>

        <Popup x:Name="AspectRatioHintPopup"
               IsHitTestVisible="True"
               IsLightDismissEnabled="False"
               Placement="Top"
               VerticalOffset="-12"
               PlacementTarget="{Binding #PanelRoot}">
            <Grid Background="Transparent"
                  PointerPressed="OnAspectRatioHintPointerPressed">
                <Border x:Name="AspectRatioHintHost"
                        Margin="28"
                        Background="Transparent"
                        Opacity="0"
                        RenderTransformOrigin="50%,50%">
                    <Border x:Name="AspectRatioHintShape"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Classes="image-preview-shadow"
                            Background="{DynamicResource SukiPopupBackground}"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Border x:Name="AspectRatioHintBorder"
                                ClipToBounds="True"
                                CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Image RenderOptions.BitmapInterpolationMode="MediumQuality"
                                   Source="avares://AtomicArt/Assets/AspectRatioHint.png"
                                   Stretch="UniformToFill" />
                        </Border>
                    </Border>
                </Border>
            </Grid>
        </Popup>

        <Canvas x:Name="CatalogLoadingIndicatorHost"
                Height="1"
                Margin="0,-2,0,0"
                VerticalAlignment="Top"
                IsVisible="{Binding IsCatalogLoading}"
                ClipToBounds="True"
                IsHitTestVisible="False">
            <Border x:Name="CatalogLoadingIndicatorBar"
                    Height="1"
                    Background="{DynamicResource SukiAccentColor}" />
        </Canvas>
    </Grid>
</UserControl>
