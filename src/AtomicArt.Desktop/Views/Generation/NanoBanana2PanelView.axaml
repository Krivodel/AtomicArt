<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="https://codewf.com"
             xmlns:behaviors="using:AtomicArt.Desktop.Behaviors"
             xmlns:contracts="using:AtomicArt.Contracts.Generation"
             xmlns:controls="using:AtomicArt.Desktop.Controls.Generation"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:generation="using:AtomicArt.Desktop.ViewModels.Generation"
             xmlns:models="using:AtomicArt.Desktop.Services"
             xmlns:resources="using:AtomicArt.Desktop.Resources"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:Class="AtomicArt.Desktop.Views.Generation.NanoBanana2PanelView"
             x:DataType="generation:UniversalNanoBananaPanelViewModel">
    <Grid x:Name="PanelRoot">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <Grid x:Name="GenerationParametersRow"
                  Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                <ComboBox Grid.Column="0"
                          MinWidth="{StaticResource GenerationModelComboMinWidth}"
                          Margin="-5,0,0,0"
                          HorizontalAlignment="Left"
                          IsEnabled="{Binding HasLoadedCatalog}"
                          ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ImageModelOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox x:Name="AspectRatioComboBox"
                          Grid.Column="1"
                          MinWidth="{StaticResource GenerationOptionComboMinWidth}"
                          IsEnabled="{Binding HasLoadedCatalog}"
                          ContainerClearing="OnAspectRatioContainerClearing"
                          ContainerPrepared="OnAspectRatioContainerPrepared"
                          DropDownClosed="OnAspectRatioDropDownClosed"
                          DropDownOpened="OnAspectRatioDropDownOpened"
                          ItemsSource="{Binding AspectRatioOptions}"
                          SelectedItem="{Binding SelectedAspectRatioOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="generation:GenerationOptionViewModel">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox x:Name="ResolutionComboBox"
                          Grid.Column="2"
                          MinWidth="{StaticResource GenerationOptionComboMinWidth}"
                          IsEnabled="{Binding HasLoadedCatalog}"
                          ItemsSource="{Binding Resolutions}"
                          SelectedItem="{Binding SelectedResolution}" />

                <Grid x:Name="GenerationOptionsSlot"
                      Grid.Column="3"
                      Margin="{StaticResource GenerationAdvancedOptionsMargin}"
                      ClipToBounds="True">
                    <Border x:Name="GenerationSettingsButtonHost"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Button x:Name="TemperatureButton"
                                Classes="Icon generation-option"
                                Click="OnTemperatureButtonClick"
                                IsEnabled="{Binding HasLoadedCatalog}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                    <Binding Path="SupportsGenerationOptions" />
                                    <Binding ElementName="InlineGenerationOptionsHost"
                                             Path="!IsHitTestVisible" />
                                </MultiBinding>
                            </Button.IsVisible>
                            <PathIcon Data="{StaticResource AppSettingsIcon}" />
                        </Button>
                    </Border>

                    <ContentControl x:Name="InlineGenerationOptionsHost"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsVisible="False"
                                    ClipToBounds="True"
                                    HorizontalContentAlignment="Left"
                                    IsHitTestVisible="False" />
                </Grid>

                <Popup x:Name="TemperaturePopup"
                       Grid.Column="3"
                       InheritsTransform="True"
                       IsLightDismissEnabled="False"
                       IsVisible="{Binding SupportsGenerationOptions}"
                       Placement="Bottom"
                       Closed="OnTemperaturePopupClosed"
                       Opened="OnTemperaturePopupOpened"
                       PlacementTarget="{Binding #TemperatureButton}">
                    <ThemeVariantScope RequestedThemeVariant="{Binding #PanelRoot.ActualThemeVariant}">
                        <FlyoutPresenter Padding="0">
                            <Border x:Name="TemperatureFlyoutPanel"
                                    Padding="12"
                                    Background="{DynamicResource SukiPopupBackground}"
                                    BorderBrush="{DynamicResource SukiMenuBorderBrush}"
                                    BorderThickness="{StaticResource ShellBorderThickness}"
                                    BoxShadow="{DynamicResource SukiPopupShadow}"
                                    CornerRadius="{StaticResource OverlayCornerRadius}"
                                    Opacity="0">
                                <StackPanel x:Name="GenerationOptionsPanel"
                                            Classes="generation-advanced-options"
                                            Spacing="12">
                                    <Grid VerticalAlignment="Center"
                                          ColumnDefinitions="Auto,Auto,*"
                                          RowDefinitions="Auto,Auto"
                                          IsVisible="{Binding SupportsTemperature}">
                                        <Button Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="0"
                                                Classes="generation-option-reset"
                                                Theme="{StaticResource GenerationOptionResetButtonTheme}"
                                                Command="{Binding ResetTemperatureCommand}">
                                            <PathIcon Data="{StaticResource AppTemperatureIcon}" />
                                        </Button>
                                        <TextBlock Grid.Row="0"
                                                   HorizontalAlignment="Center"
                                                   Classes="panel-label generation-temperature-value"
                                                   Text="{Binding TemperatureText}" />
                                        <Slider x:Name="TemperatureSlider"
                                                Grid.Column="2"
                                                IsSnapToTickEnabled="True"
                                                LargeChange="{Binding TemperatureStep}"
                                                Maximum="{Binding MaximumTemperature}"
                                                Minimum="{Binding MinimumTemperature}"
                                                SmallChange="{Binding TemperatureStep}"
                                                TickFrequency="{Binding TemperatureStep}"
                                                Value="{Binding Temperature, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*"
                                          IsVisible="{Binding SupportsQuality}">
                                        <Button Grid.Column="0"
                                                Classes="generation-option-reset"
                                                Theme="{StaticResource GenerationOptionResetButtonTheme}"
                                                Command="{Binding ResetQualityCommand}">
                                            <PathIcon Data="{StaticResource AppQualityIcon}" />
                                        </Button>
                                        <ComboBox Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  MaxDropDownHeight="300"
                                                  Classes.gpt-quality="{Binding UsesGptImageQuality}"
                                                  AutomationProperties.Name="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Quality.Label}}"
                                                  ItemsSource="{Binding QualityLevels}"
                                                  SelectedItem="{Binding SelectedQualityOption, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="generation:GenerationOptionViewModel">
                                                    <TextBlock Classes="quality-option"
                                                               Tag="{Binding Value}"
                                                               Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*"
                                          IsVisible="{Binding SupportsThinkingLevel}">
                                        <Button Grid.Column="0"
                                                Classes="generation-option-reset"
                                                Theme="{StaticResource GenerationOptionResetButtonTheme}"
                                                Command="{Binding ResetThinkingLevelCommand}">
                                            <PathIcon Data="{StaticResource AppBrainIcon}" />
                                        </Button>
                                        <ComboBox x:Name="ThinkingLevelComboBox"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding ThinkingLevels}"
                                                  SelectedItem="{Binding SelectedThinkingLevel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="contracts:GenerationModelThinkingLevelMetadataDto">
                                                    <TextBlock Text="{i18n:I18n {Binding LocalizationKey}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </FlyoutPresenter>
                    </ThemeVariantScope>
                </Popup>

                <ComboBox x:Name="GenerationCountComboBox"
                          Grid.Column="4"
                          MaxWidth="{StaticResource GenerationOptionComboMinWidth}"
                          Margin="0,0,-5,0"
                          HorizontalAlignment="Right"
                          IsEnabled="{Binding HasLoadedCatalog}"
                          ItemsSource="{Binding GenerationCounts}"
                          SelectedItem="{Binding GenerationCount}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="system:Int32">
                            <TextBlock Text="{Binding StringFormat='x{0}'}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="{StaticResource GenerationPanelInnerSpacing}"
                  ColumnDefinitions="Auto,Auto,*">
                <Button Grid.Column="0"
                        Classes="attach-image"
                        IsEnabled="{Binding HasLoadedCatalog}"
                        Command="{Binding PickImageCommand}">
                    <PathIcon Data="{StaticResource AppAddIcon}" />
                </Button>
                <TextBlock Grid.Column="1"
                           Margin="{StaticResource AttachmentListMargin}"
                           MinWidth="36"
                           VerticalAlignment="Center"
                           Classes="panel-label"
                           Text="{Binding AttachmentCounterText}" />
                <Grid Grid.Column="2"
                      Margin="{StaticResource AttachmentListMargin}">
                    <controls:AnimatedAttachmentListControl Items="{Binding AttachedImages}"
                                                            OpenAttachmentCommand="{Binding OpenAttachmentCommand}"
                                                            PanelId="{Binding PanelId}"
                                                            RemoveAttachmentCommand="{Binding RemoveAttachmentCommand}"
                                                            ReorderAttachmentCommand="{Binding ReorderAttachmentCommand}" />
                </Grid>
            </Grid>

            <TextBox x:Name="PromptTextBox"
                     Grid.Row="2"
                     MinHeight="{StaticResource PromptHeight}"
                     Margin="{StaticResource GenerationPanelInnerSpacing}"
                     VerticalContentAlignment="Top"
                     Classes="prompt-input"
                     IsEnabled="{Binding HasLoadedCatalog}"
                     AcceptsReturn="True"
                     behaviors:ClipboardPasteBehavior.IsEnabled="True"
                     behaviors:TextBoxFocusBehavior.AutoFocus="{Binding HasLoadedCatalog}"
                     LostFocus="OnPromptLostFocus"
                     PlaceholderText="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Prompt.Placeholder}}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     FontSize="{Binding PromptTextSize}"
                     Text="{Binding Prompt}"
                     behaviors:PromptTextSizeWheelBehavior.AdjustCommand="{Binding AdjustPromptTextSizeCommand}" />

            <TextBlock Grid.Row="3"
                       Margin="{StaticResource GenerationPanelInnerSpacing}"
                       Classes="error-message danger-text"
                       IsVisible="{Binding HasErrorMessage}"
                       Text="{Binding ErrorMessage}" />

            <Button Grid.Row="4"
                    Margin="{StaticResource GenerationPanelInnerSpacing}"
                    HorizontalAlignment="Stretch"
                    Content="{Binding Quote.GenerateButtonText}"
                    Command="{Binding GenerateCommand}" />
        </Grid>

        <Popup x:Name="AspectRatioHintPopup"
               PlacementTarget="{Binding #PanelRoot}"
               Placement="Top"
               VerticalOffset="-12"
               IsLightDismissEnabled="False"
               IsHitTestVisible="True">
            <Grid Background="Transparent"
                  PointerPressed="OnAspectRatioHintPointerPressed">
                <Border x:Name="AspectRatioHintHost"
                        Margin="28"
                        Opacity="0"
                        Background="Transparent"
                        RenderTransformOrigin="50%,50%">
                    <Border x:Name="AspectRatioHintShape"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                             Classes="image-preview-shadow"
                             Background="{DynamicResource SukiPopupBackground}"
                             CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Border x:Name="AspectRatioHintBorder"
                                ClipToBounds="True"
                                CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Image Source="avares://AtomicArt/Assets/AspectRatioHint.png"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapInterpolationMode="MediumQuality" />
                        </Border>
                    </Border>
                </Border>
            </Grid>
        </Popup>

        <Canvas x:Name="CatalogLoadingIndicatorHost"
                Height="1"
                Margin="0,-2,0,0"
                VerticalAlignment="Top"
                ClipToBounds="True"
                IsHitTestVisible="False"
                IsVisible="{Binding IsCatalogLoading}">
            <Border x:Name="CatalogLoadingIndicatorBar"
                    Height="1"
                    Background="{DynamicResource SukiAccentColor}" />
        </Canvas>
    </Grid>
</UserControl>
