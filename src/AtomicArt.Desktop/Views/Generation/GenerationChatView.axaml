<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:behaviors="using:AtomicArt.Desktop.Behaviors"
             xmlns:galleryServices="using:AtomicArt.Desktop.Services.Gallery"
             xmlns:generation="using:AtomicArt.Desktop.ViewModels.Generation"
             xmlns:i18n="https://codewf.com"
             xmlns:resources="using:AtomicArt.Desktop.Resources"
             xmlns:views="using:AtomicArt.Desktop.Views.Generation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomicArt.Desktop.Views.Generation.GenerationChatView"
             x:Name="ChatView"
             x:DataType="generation:GenerationChatViewModel"
             ClipToBounds="False"
             behaviors:TextSizeWheelBehavior.AdjustCommand="{Binding AdjustTextSizeCommand}">
    <Border x:Name="HistoryChrome"
            Classes="generation-chat-history"
            Classes.expanded="{Binding #ChatView.IsPresented}">
        <Border ClipToBounds="True"
                CornerRadius="{Binding #HistoryChrome.CornerRadius}">
            <Grid>
                <Border VerticalAlignment="Top"
                        Classes="generation-chat-header"
                        ZIndex="1">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                MinHeight="{StaticResource TitleButtonSize}"
                                Margin="{StaticResource GenerationChatHeaderPadding}"
                                Padding="{StaticResource GenerationChatReturnPadding}"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding CanReturnToSource}"
                                Command="{Binding ReturnToSourceCommand}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource GenerationChatItemSpacing}">
                                <Path VerticalAlignment="Center"
                                      Classes="metadata-outline-icon"
                                      Data="{StaticResource AppBackIcon}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{i18n:I18n {x:Static resources:GenerationChatLocalizationKeys.ReturnToSource}}" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="1"
                                Padding="{StaticResource GenerationChatHeaderPadding}"
                                Background="Transparent">
                            <Grid ColumnDefinitions="Auto,Auto,Auto">
                                <Button Grid.Column="0"
                                        Width="{StaticResource TitleButtonSize}"
                                        Height="{StaticResource TitleButtonSize}"
                                        Padding="{StaticResource ZeroThickness}"
                                        Classes="Icon"
                                        AutomationProperties.Name="{i18n:I18n {x:Static resources:GalleryLocalizationKeys+Actions.ShowInGallery}}"
                                        Command="{Binding ShowInGalleryCommand}">
                                    <PathIcon Data="{x:Static galleryServices:AtomicArtPicaActions.ShowInGalleryIconGeometry}" />
                                </Button>
                                <Button Grid.Column="1"
                                        Width="{StaticResource TitleButtonSize}"
                                        Height="{StaticResource TitleButtonSize}"
                                        Padding="{StaticResource ZeroThickness}"
                                        Classes="Icon"
                                        AutomationProperties.Name="{i18n:I18n {x:Static resources:GenerationChatLocalizationKeys.Branches}}"
                                        Command="{Binding OpenBranchMapCommand}">
                                    <Path Classes="metadata-outline-icon"
                                          Data="{StaticResource AppBranchIcon}" />
                                </Button>
                                <Button Grid.Column="2"
                                        Width="{StaticResource TitleButtonSize}"
                                        Height="{StaticResource TitleButtonSize}"
                                        Padding="{StaticResource ZeroThickness}"
                                        Classes="Icon"
                                        AutomationProperties.Name="{i18n:I18n {x:Static resources:GenerationChatLocalizationKeys.Collapse}}"
                                        Command="{Binding CollapseCommand}">
                                    <PathIcon Data="{StaticResource AppCloseIcon}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <ItemsControl x:Name="ChatItems"
                              ItemsSource="{Binding Messages}">
                    <ItemsControl.Template>
                        <ControlTemplate x:DataType="ItemsControl">
                            <ScrollViewer x:Name="ChatScrollViewer"
                                          Classes="generation-chat-scroll"
                                          BringIntoViewOnFocusChange="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter Margin="{StaticResource GenerationChatContentMargin}"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="generation:GenerationChatMessageViewModel">
                            <views:GenerationChatMessageView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="PreviousBranch"
                        IsVisible="False"
                        Background="{DynamicResource SukiPopupBackground}"
                        IsHitTestVisible="False">
                    <Image x:Name="PreviousBranchImage"
                           Stretch="Fill" />
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
