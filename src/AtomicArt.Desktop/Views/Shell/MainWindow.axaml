<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:i18n="https://codewf.com"
                 xmlns:behaviors="using:AtomicArt.Desktop.Behaviors"
                 xmlns:controls="using:AtomicArt.Desktop.Controls.Generation"
                 xmlns:dlss5="using:AtomicArt.Desktop.Services.Dlss5"
                 xmlns:galleryViews="using:AtomicArt.Desktop.Views.Gallery"
                 xmlns:overlays="using:AtomicArt.Desktop.Controls.Overlays"
                 xmlns:resources="using:AtomicArt.Desktop.Resources"
                 xmlns:suki="using:SukiUI.Controls"
                 xmlns:uiControls="using:AtomicArt.Desktop.Controls"
                 xmlns:viewModels="using:AtomicArt.Desktop.ViewModels"
                 x:Class="AtomicArt.Desktop.Views.Shell.MainWindow"
                 x:DataType="viewModels:MainWindowViewModel"
                 Width="{StaticResource MainWindowWidth}"
                 Height="{StaticResource MainWindowHeight}"
                 MinWidth="{StaticResource MainWindowMinWidth}"
                 MinHeight="{StaticResource MainWindowMinHeight}"
                 CanFullScreen="True"
                 CanPin="True"
                 IsMenuVisible="False"
                 behaviors:Dlss5ClipboardPasteBehavior.IsEnabled="{Binding Dlss5.IsOpen}"
                 behaviors:Dlss5ClipboardPasteBehavior.PasteCommand="{Binding Dlss5.PasteSourceCommand}"
                 behaviors:ImageDropBehavior.IsEnabled="True"
                 behaviors:ImageDropBehavior.Overlay="{Binding #WindowDropOverlay}"
                 behaviors:ImageDropBehavior.TargetKind="ExternalFiles"
                 Icon="/Assets/AppIcon.ico"
                 Title="{x:Static resources:ProductInformation.Name}"
                 TitleBarAutoHideDelay="0"
                 behaviors:ImageAttachmentBehavior.AttachImagesCommand="{Binding AttachWindowImagesCommand}"
                 behaviors:ImageAttachmentBehavior.ErrorCommand="{Binding HandleExternalInputErrorCommand}"
                 behaviors:ImageAttachmentBehavior.MaxInputBytes="{Binding WindowImageInputByteLimit}">
    <suki:SukiWindow.KeyBindings>
        <KeyBinding Gesture="Escape"
                    Command="{Binding HandleEscapeCommand}" />
        <KeyBinding Gesture="Delete"
                    Command="{Binding Gallery.DeleteSelectedCommand}" />
    </suki:SukiWindow.KeyBindings>

    <suki:SukiWindow.LogoContent>
        <Image Width="{StaticResource TitleLogoSize}"
               Height="{StaticResource TitleLogoSize}"
               Source="avares://AtomicArt/Assets/AppIcon.ico"
               RenderOptions.BitmapInterpolationMode="MediumQuality" />
    </suki:SukiWindow.LogoContent>

    <suki:SukiWindow.RightWindowTitleBarControls>
        <Button Classes="Icon title-action"
                Command="{Binding OpenSettingsCommand}">
            <PathIcon Data="{StaticResource AppSettingsIcon}" />
        </Button>
        <Button Classes="Icon title-action"
                Command="{Binding OpenDlss5Command}">
            <PathIcon Data="{x:Static dlss5:Dlss5FeatureDefinition.NvidiaIconGeometry}"
                      Foreground="{StaticResource NvidiaBrandBrush}" />
        </Button>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <suki:SukiWindow.Hosts>
        <suki:SukiToastHost x:Name="UpdateToastHost"
                            MaxToasts="1"
                            Position="BottomRight"
                            RenderTransformOrigin="100%,100%">
            <suki:SukiToastHost.RenderTransform>
                <ScaleTransform ScaleX="{Binding UiScale}"
                                ScaleY="{Binding UiScale}" />
            </suki:SukiToastHost.RenderTransform>
        </suki:SukiToastHost>
    </suki:SukiWindow.Hosts>

    <Grid>
        <LayoutTransformControl>
            <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding UiScale}"
                                ScaleY="{Binding UiScale}" />
            </LayoutTransformControl.LayoutTransform>

            <Grid>
                <Grid x:Name="ShellContentGrid"
                      behaviors:ImageAttachmentBehavior.AttachImagesCommand="{Binding ActiveGenerationPanel.AttachImageInputsCommand}"
                      IsVisible="{Binding !Dlss5.IsOpen}"
                      behaviors:ImageDropBehavior.DropArea="{Binding #GenerationPanelHost}"
                      behaviors:ImageDropBehavior.IsEnabled="{Binding !Gallery.IsSelectionMode}"
                      behaviors:ImageDropBehavior.Overlay="{Binding #PanelDropOverlay}"
                      behaviors:ImageDropBehavior.TargetKind="GalleryImage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"
                                       MinHeight="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="{StaticResource GalleryViewportMargin}">
                        <ContentControl Content="{Binding Gallery}" />
                    </Border>

                    <Border x:Name="GenerationPanelHost"
                            Grid.Row="1"
                            MaxWidth="{StaticResource GenerationPanelWidth}"
                            Margin="{StaticResource GenerationPanelMargin}"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            Classes="generation-panel"
                            behaviors:PromptDropBehavior.IsEnabled="{Binding !Gallery.IsSelectionMode}"
                            behaviors:PromptDropBehavior.Overlay="{Binding #PromptDropOverlay}"
                            ClipToBounds="True"
                            behaviors:PromptDropBehavior.ReplacePromptCommand="{Binding ReplaceGenerationPromptCommand}">
                        <Grid>
                            <Border x:Name="GenerationPanelContent"
                                    Background="Transparent"
                                    Padding="{StaticResource GenerationPanelPadding}"
                                    Classes="generation-panel-content"
                                    Classes.selection-mode="{Binding Gallery.IsSelectionMode}"
                                    IsHitTestVisible="{Binding !Gallery.IsSelectionMode}">
                                <Border.Resources>
                                    <uiControls:AnimatedContextMenuFlyout x:Key="GenerationPanelContextFlyout">
                                        <MenuItem x:Name="ResetGenerationPanelMenuItem"
                                                  Command="{Binding ActiveGenerationPanel.ResetPanelCommand}">
                                            <MenuItem.Header>
                                                <TextBlock Classes="context-menu-item-header"
                                                           Text="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Actions.Reset}}" />
                                            </MenuItem.Header>
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource AppResetIcon}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </uiControls:AnimatedContextMenuFlyout>
                                </Border.Resources>
                                <ContentControl Content="{Binding ActiveGenerationPanel}" />
                            </Border>

                            <controls:ImageDropOverlayControl x:Name="PanelDropOverlay"
                                                              ZIndex="20"
                                                              IsAttachmentLimitReached="{Binding ActiveGenerationPanel.IsAttachmentLimitReached}"
                                                              BackdropCornerRadius="{StaticResource ShellCornerRadius}" />

                            <controls:ImageDropOverlayControl x:Name="PromptDropOverlay"
                                                              ZIndex="20"
                                                              BackdropCornerRadius="{StaticResource ShellCornerRadius}" />

                            <galleryViews:GallerySelectionOverlayView ZIndex="30"
                                                                      IsActive="{Binding IsSelectionMode}"
                                                                      DataContext="{Binding Gallery}" />
                        </Grid>
                    </Border>

                    <GridSplitter x:Name="GenerationPanelResizeGrip"
                                  Grid.Row="1"
                                  ZIndex="1"
                                  Height="{StaticResource GenerationPanelResizeGripHeight}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top"
                                  Background="Transparent"
                                  Cursor="SizeNorthSouth"
                                  ResizeBehavior="PreviousAndCurrent"
                                  ResizeDirection="Rows"
                                  ShowsPreview="False" />
                </Grid>

                <ContentControl Content="{Binding Dlss5}"
                                IsVisible="{Binding Dlss5.IsOpen}" />

                <overlays:ModalOverlayLayerControl ZIndex="10">
                    <overlays:ModalOverlayPresenterControl x:Name="SettingsOverlayPresenter"
                                                           Order="{StaticResource SettingsModalOverlayOrder}"
                                                           Body="{Binding Settings}"
                                                           IsOpen="{Binding IsSettingsOpen}"
                                                           CloseCommand="{Binding Settings.CloseCommand}" />
                    <overlays:ModalOverlayPresenterControl Order="{StaticResource MetadataModalOverlayOrder}"
                                                           Body="{Binding Gallery.SelectedMetadata}"
                                                           IsOpen="{Binding Gallery.IsMetadataOpen}"
                                                           CloseCommand="{Binding Gallery.CloseOverlayCommand}" />
                    <overlays:ModalOverlayPresenterControl Order="{StaticResource ErrorDialogModalOverlayOrder}"
                                                           Body="{Binding ErrorDialog}"
                                                           IsOpen="{Binding ErrorDialog.IsOpen}"
                                                           CloseCommand="{Binding ErrorDialog.CloseCommand}" />
                </overlays:ModalOverlayLayerControl>

                <controls:ImageDropOverlayControl x:Name="WindowDropOverlay"
                                                  ZIndex="30"
                                                  IsAttachmentLimitReached="{Binding IsWindowAttachmentLimitReached}"
                                                  IconSize="200" />
            </Grid>
        </LayoutTransformControl>

        <suki:SukiDialogHost x:Name="ConfirmationDialogHost"
                             Classes="confirmation-dialog-host" />
    </Grid>
</suki:SukiWindow>
