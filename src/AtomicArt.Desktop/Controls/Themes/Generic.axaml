<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:Avalonia.Data.Converters"
        xmlns:overlays="using:AtomicArt.Desktop.Controls.Overlays">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type overlays:ModalOverlayControl}"
                      TargetType="overlays:ModalOverlayControl">
            <Setter Property="Margin"
                    Value="{DynamicResource OverlayMargin}" />
            <Setter Property="Padding"
                    Value="{DynamicResource OverlayPadding}" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="{DynamicResource ModalOverlayTintBrush}" />
            <Setter Property="BlurRadius"
                    Value="{DynamicResource ModalOverlayBlurRadius}" />
            <Setter Property="IsBlurDynamic"
                    Value="False" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="{DynamicResource ShellBorderThickness}" />
            <Setter Property="ClipToBounds"
                    Value="False" />
            <Setter Property="CornerRadius"
                    Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="Template">
                <ControlTemplate x:DataType="overlays:ModalOverlayControl">
                    <Grid>
                        <Border x:Name="PART_ShadowChrome"
                                BoxShadow="{DynamicResource FloatingSurfaceShadow}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="PART_BackgroundChrome"
                                    ClipToBounds="True"
                                    Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                    <overlays:BlurBackdropControl x:Name="PART_BlurBackdrop"
                                                                  BlurRadius="{TemplateBinding BlurRadius}"
                                                                  Intensity="{TemplateBinding BlurIntensity}"
                                                                  IsDynamic="{TemplateBinding IsBlurDynamic}" />
                                    <Border Background="{TemplateBinding Background}" />
                                </Grid>
                            </Border>
                        </Border>

                        <Grid Margin="{TemplateBinding Padding}"
                              RowDefinitions="Auto,*">
                            <Border x:Name="PART_Header">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Panel>
                                        <TextBlock Classes="overlay-title"
                                                   IsVisible="{TemplateBinding Header, Converter={x:Static converters:ObjectConverters.IsNull}}"
                                                   Text="{TemplateBinding Title}" />
                                        <ContentPresenter Content="{TemplateBinding Header}" />
                                    </Panel>
                                    <ContentPresenter Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding HeaderAccessory}" />
                                    <Button Grid.Column="2"
                                            Classes="Icon close-action"
                                            Command="{TemplateBinding CloseCommand}">
                                        <PathIcon Data="{StaticResource AppCloseIcon}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ContentControl Grid.Row="1"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Content="{TemplateBinding Body}" />
                        </Grid>
                        <ContentPresenter HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          IsHitTestVisible="False"
                                          IsVisible="{TemplateBinding VisualOverlay, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                                          Content="{TemplateBinding VisualOverlay}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="overlays|ModalOverlayControl.gradient-surface">
        <Setter Property="Padding"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="Background"
                Value="{StaticResource MetadataSurfaceBrush}" />
        <Setter Property="BlurRadius"
                Value="0" />
        <Setter Property="BorderThickness"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource GradientOverlayCornerRadius}" />
    </Style>

    <Style Selector="overlays|ModalOverlayControl.gradient-surface /template/ Border#PART_Header">
        <Setter Property="MinHeight"
                Value="57" />
        <Setter Property="Padding"
                Value="21,8,15,8" />
        <Setter Property="Background"
                Value="{StaticResource MetadataHeaderBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource MetadataDividerBrush}" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
        <Setter Property="CornerRadius"
                Value="{StaticResource GradientOverlayHeaderCornerRadius}" />
    </Style>

    <Style Selector="overlays|ModalOverlayControl.gradient-surface /template/ Button.close-action">
        <Setter Property="Foreground"
                Value="{StaticResource MetadataSecondaryTextBrush}" />
    </Style>
</Styles>
