<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:settings="using:AtomicArt.Desktop.Controls.Settings"
             x:Class="AtomicArt.Desktop.Controls.Settings.SettingItemControl"
             x:Name="Root"
             x:DataType="settings:SettingItemControl">
    <Grid RowDefinitions="Auto,Auto,Auto">
        <TextBlock VerticalAlignment="Center"
                   Classes="settings-label"
                   IsVisible="{Binding #Root.Header, Converter={x:Static converters:ObjectConverters.IsNull}}"
                   Text="{Binding #Root.DisplayName}" />
        <ContentControl HorizontalContentAlignment="Stretch"
                        IsVisible="{Binding #Root.Header, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                        Content="{Binding #Root.Header}" />
        <ContentControl Grid.Row="1"
                        Margin="{StaticResource SettingsEditorMargin}"
                        HorizontalContentAlignment="Stretch"
                        Content="{Binding #Root.Editor}" />
        <TextBlock Grid.Row="2"
                   Margin="{StaticResource SettingsErrorMargin}"
                   Classes="error-message danger-text"
                   IsVisible="{Binding #Root.HasErrorMessage}"
                   Text="{Binding #Root.ErrorMessage}" />
    </Grid>
</UserControl>
