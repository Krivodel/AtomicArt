<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="https://codewf.com"
             xmlns:controls="using:AtomicArt.Desktop.Controls.Generation"
             xmlns:overlays="using:AtomicArt.Desktop.Controls.Overlays"
             xmlns:resources="using:AtomicArt.Desktop.Resources"
             x:Class="AtomicArt.Desktop.Controls.Generation.ImageDropOverlayControl"
             x:Name="Root"
             x:DataType="controls:ImageDropOverlayControl"
             ClipToBounds="True"
             IsHitTestVisible="False">
    <Grid>
        <overlays:AnimatedBlurBackdropControl x:Name="AnimatedBackdrop"
                                              BackdropCornerRadius="{Binding #Root.BackdropCornerRadius}"
                                              BlurRadius="{DynamicResource TransientOverlayBlurRadius}" />

        <Border x:Name="CapacityTint"
                Background="{DynamicResource SukiDangerColor}"
                CornerRadius="{Binding #Root.BackdropCornerRadius}"
                Opacity="0">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Duration="{StaticResource TransientOverlayFadeDuration}"
                                      Easing="{StaticResource TransientOverlayEasing}"
                                      Property="Opacity" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <controls:ImageDropDashedBorderControl x:Name="OverlayChrome"
                                               Margin="10"
                                               Opacity="0"
                                               StrokeColor="{DynamicResource ImageDropBorderColor}">
            <controls:ImageDropDashedBorderControl.Transitions>
                <Transitions>
                    <DoubleTransition Duration="{StaticResource TransientOverlayFadeDuration}"
                                      Easing="{StaticResource TransientOverlayEasing}"
                                      Property="Opacity" />
                </Transitions>
            </controls:ImageDropDashedBorderControl.Transitions>
        </controls:ImageDropDashedBorderControl>

        <StackPanel x:Name="AnimatedContent"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0"
                    RenderTransform="scale(0.97) translate(0px, -8px)"
                    RenderTransformOrigin="50%,50%"
                    Spacing="7">
            <StackPanel.Transitions>
                <Transitions>
                    <DoubleTransition Duration="{StaticResource TransientOverlayFadeDuration}"
                                      Easing="{StaticResource TransientOverlayEasing}"
                                      Property="Opacity" />
                    <TransformOperationsTransition Duration="0:0:0.22"
                                                   Easing="{StaticResource TransientOverlayEasing}"
                                                   Property="RenderTransform" />
                </Transitions>
            </StackPanel.Transitions>

            <Image x:Name="DropIcon"
                   Width="{Binding #Root.IconSize}"
                   Height="{Binding #Root.IconSize}"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="MediumQuality"
                   Source="avares://AtomicArt/Assets/DropIcon.png"
                   Stretch="Uniform">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      Color="#000000"
                                      OffsetX="0"
                                      OffsetY="14"
                                      Opacity="0.8" />
                </Image.Effect>
            </Image>

            <TextBlock x:Name="DropLabel"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SukiText}"
                       Opacity="0.8"
                       Text="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys.ImageDropLabel}}" />

            <TextBlock x:Name="NoSlotsLabel"
                       HorizontalAlignment="Center"
                       IsVisible="False"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SukiDangerForeground}"
                       Text="{i18n:I18n {x:Static resources:GenerationUiLocalizationKeys+Attachments.NoSlots}}" />
        </StackPanel>
    </Grid>
</UserControl>
