<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="using:System">
    <system:TimeSpan x:Key="TransientOverlayFadeDuration">0:0:0.18</system:TimeSpan>
    <system:TimeSpan x:Key="GallerySelectionOverlaySlideDuration">0:0:0.24</system:TimeSpan>
    <system:TimeSpan x:Key="GenerationCardVisualStateTransitionDuration">0:0:0.15</system:TimeSpan>
    <system:TimeSpan x:Key="ConfirmationDialogTransitionDuration">0:0:0.2</system:TimeSpan>
    <system:TimeSpan x:Key="ConfirmationDialogOpacityTransitionDuration">0:0:0.1</system:TimeSpan>
    <CubicEaseOut x:Key="TransientOverlayEasing" />
</ResourceDictionary>
