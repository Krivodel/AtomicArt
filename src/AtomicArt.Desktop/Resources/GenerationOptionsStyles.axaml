<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ControlTheme x:Key="GenerationOptionResetButtonTheme"
                      TargetType="Button">
            <Setter Property="Width"
                    Value="{StaticResource GenerationOptionIconSize}" />
            <Setter Property="Height"
                    Value="{StaticResource GenerationOptionIconSize}" />
            <Setter Property="MinWidth"
                    Value="{StaticResource ZeroSize}" />
            <Setter Property="MinHeight"
                    Value="{StaticResource ZeroSize}" />
            <Setter Property="Margin"
                    Value="0,0,10,0" />
            <Setter Property="Padding"
                    Value="{StaticResource ZeroThickness}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="{StaticResource ZeroThickness}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource SukiText}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground"
                                     Duration="{StaticResource GenerationOptionResetHoverDuration}" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate x:DataType="Button">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground"
                        Value="{DynamicResource SukiDangerColor}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Button.generation-option-reset">
        <Setter Property="Cursor"
                Value="Arrow" />
    </Style>

    <Style Selector="ComboBox.gpt-quality TextBlock.quality-option[Tag=Low]">
        <Setter Property="Foreground"
                Value="{StaticResource GptQualityLowBrush}" />
    </Style>

    <Style Selector="ComboBox.gpt-quality TextBlock.quality-option[Tag=Medium]">
        <Setter Property="Foreground"
                Value="{StaticResource GptQualityMediumBrush}" />
    </Style>

    <Style Selector="ComboBox.gpt-quality TextBlock.quality-option[Tag=High]">
        <Setter Property="Foreground"
                Value="{StaticResource GptQualityHighBrush}" />
    </Style>

    <Style Selector="ComboBox.gpt-quality TextBlock.quality-option[Tag=Xhigh]">
        <Setter Property="Foreground"
                Value="{StaticResource GptQualityXhighBrush}" />
    </Style>

    <Style Selector="ComboBox.gpt-quality TextBlock.quality-option[Tag=Max]">
        <Setter Property="Foreground"
                Value="{StaticResource GptQualityMaxBrush}" />
    </Style>

    <Style Selector="Button.generation-option-reset PathIcon">
        <Setter Property="Width"
                Value="{StaticResource GenerationOptionIconSize}" />
        <Setter Property="Height"
                Value="{StaticResource GenerationOptionIconSize}" />
    </Style>

    <Style Selector="StackPanel.generation-advanced-options ComboBox">
        <Setter Property="MinWidth"
                Value="{StaticResource GenerationTemperatureSliderWidth}" />
    </Style>

    <Style Selector="StackPanel.generation-advanced-options Slider">
        <Setter Property="Grid.Row"
                Value="1" />
        <Setter Property="Width"
                Value="{StaticResource GenerationTemperatureSliderWidth}" />
    </Style>

    <Style Selector="StackPanel.generation-advanced-options TextBlock.generation-temperature-value">
        <Setter Property="Grid.Column"
                Value="2" />
        <Setter Property="Margin"
                Value="0,0,0,4" />
    </Style>

    <Style Selector="StackPanel.generation-advanced-options.inline">
        <Setter Property="Orientation"
                Value="Horizontal" />
    </Style>

    <Style Selector="StackPanel.generation-advanced-options.inline ComboBox">
        <Setter Property="MinWidth"
                Value="{StaticResource GenerationOptionComboMinWidth}" />
    </Style>

    <Style Selector="StackPanel.generation-advanced-options.inline Slider">
        <Setter Property="Grid.Row"
                Value="0" />
        <Setter Property="Width"
                Value="{StaticResource GenerationOptionComboMinWidth}" />
    </Style>

    <Style Selector="StackPanel.generation-advanced-options.inline TextBlock.generation-temperature-value">
        <Setter Property="Grid.Column"
                Value="1" />
        <Setter Property="Margin"
                Value="0,0,8,0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>
</Styles>
