<Styles xmlns="https://github.com/avaloniaui"
        xmlns:behaviors="using:AtomicArt.Desktop.Behaviors"
        xmlns:overlays="using:AtomicArt.Desktop.Controls.Overlays"
        xmlns:views="using:AtomicArt.Desktop.Views.Gallery"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ControlTheme x:Key="MetadataNavigationButtonTheme"
                      TargetType="Button">
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="Foreground"
                    Value="{StaticResource MetadataTextBrush}" />
            <Setter Property="Template">
                <ControlTemplate x:DataType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="NavigationIconHost"
                                Width="{StaticResource MetadataNavigationButtonSize}"
                                Height="{StaticResource MetadataNavigationButtonSize}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource MetadataDividerBrush}"
                                CornerRadius="0,8,8,0"
                                Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Duration="{StaticResource TransientOverlayFadeDuration}"
                                                      Easing="{StaticResource TransientOverlayEasing}"
                                                      Property="Opacity" />
                                </Transitions>
                            </Border.Transitions>
                            <Path x:Name="NavigationChevron"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource MetadataNavigationIcon}"
                                  Fill="{TemplateBinding Foreground}"
                                  Stretch="None" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^.previous /template/ Border#NavigationIconHost">
                <Setter Property="HorizontalAlignment"
                        Value="Right" />
                <Setter Property="CornerRadius"
                        Value="8,0,0,8" />
            </Style>
            <Style Selector="^.previous /template/ Path#NavigationChevron">
                <Setter Property="RenderTransform"
                        Value="scale(-1,1)" />
            </Style>
            <Style Selector="^:pointerover:not(:disabled) /template/ Border#NavigationIconHost">
                <Setter Property="Opacity"
                        Value="1" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="IsHitTestVisible"
                        Value="False" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="MetadataReferenceButtonTheme"
                      TargetType="Button">
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate x:DataType="Button">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Background="Transparent"
                                      Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="ScrollViewer.metadata-references /template/ ScrollContentPresenter#PART_ContentPresenter">
        <Setter Property="behaviors:ScrollFadeMaskBehavior.Orientation"
                Value="Horizontal" />
        <Setter Property="behaviors:ScrollFadeMaskBehavior.FadeWhenClipped"
                Value="True" />
        <Setter Property="behaviors:ScrollFadeMaskBehavior.Insets"
                Value="{StaticResource MetadataReferencesScrollInsets}" />
    </Style>

    <Style Selector="views|GenerationReferencePreviewControl">
        <Setter Property="Opacity"
                Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Duration="{StaticResource TransientOverlayFadeDuration}"
                                  Easing="{StaticResource TransientOverlayEasing}"
                                  Property="Opacity" />
            </Transitions>
        </Setter>
        <Style Selector="^:decoded">
            <Setter Property="Opacity"
                    Value="1" />
        </Style>
    </Style>

    <Style Selector="overlays|ModalOverlayControl.generation-metadata /template/ Border#PART_ShadowChrome">
        <Setter Property="Background"
                Value="Transparent" />
    </Style>

    <Style Selector="overlays|ModalOverlayControl.generation-metadata /template/ TextBlock.overlay-title">
        <Setter Property="FontSize"
                Value="18" />
        <Setter Property="Foreground"
                Value="{StaticResource MetadataTextBrush}" />
    </Style>

    <Style Selector="overlays|ModalOverlayControl.generation-metadata /template/ Button.close-action">
        <Setter Property="IsVisible"
                Value="False" />
    </Style>

    <Style Selector="Border.metadata-status">
        <Setter Property="Padding"
                Value="9,4" />
        <Setter Property="Background"
                Value="{StaticResource MetadataPreviewBrush}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource MetadataStatusCornerRadius}" />
    </Style>

    <Style Selector="TextBlock.metadata-status-text">
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource MetadataSecondaryTextBrush}" />
    </Style>

    <Style Selector="Ellipse.metadata-status-dot">
        <Setter Property="Fill"
                Value="{StaticResource MetadataSecondaryTextBrush}" />
    </Style>

    <Style Selector="Border.metadata-status.generated">
        <Setter Property="Background"
                Value="{StaticResource MetadataReadySurfaceBrush}" />
        <Style Selector="^ TextBlock.metadata-status-text">
            <Setter Property="Foreground"
                    Value="{StaticResource MetadataReadyBrush}" />
        </Style>
        <Style Selector="^ Ellipse.metadata-status-dot">
            <Setter Property="Fill"
                    Value="{StaticResource MetadataReadyBrush}" />
        </Style>
    </Style>

    <Style Selector="Border.metadata-status.generating">
        <Setter Property="Background"
                Value="{StaticResource MetadataGeneratingSurfaceBrush}" />
        <Style Selector="^ TextBlock.metadata-status-text">
            <Setter Property="Foreground"
                    Value="{StaticResource MetadataGeneratingBrush}" />
        </Style>
        <Style Selector="^ Ellipse.metadata-status-dot">
            <Setter Property="Fill"
                    Value="{StaticResource MetadataGeneratingBrush}" />
        </Style>
    </Style>

    <Style Selector="Border.metadata-status.failed">
        <Setter Property="Background"
                Value="{StaticResource MetadataFailedSurfaceBrush}" />
        <Style Selector="^ TextBlock.metadata-status-text">
            <Setter Property="Foreground"
                    Value="{StaticResource MetadataFailedBrush}" />
        </Style>
        <Style Selector="^ Ellipse.metadata-status-dot">
            <Setter Property="Fill"
                    Value="{StaticResource MetadataFailedBrush}" />
        </Style>
    </Style>

    <Style Selector="views|GenerationPreviewControl.metadata-preview Border.generation-card-preview,
                     views|GenerationPreviewControl.metadata-preview Border.generation-card-empty,
                     views|GenerationPreviewControl.metadata-preview Border.generation-card-error">
        <Setter Property="Background"
                Value="{StaticResource MetadataPreviewBrush}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource GenerationCardCornerRadius}" />
    </Style>

    <Style Selector="views|GenerationPreviewControl.metadata-preview Image.generation-card-image">
        <Setter Property="Stretch"
                Value="Uniform" />
    </Style>

    <Style Selector="views|GenerationPreviewControl.metadata-preview TextBlock.generation-card-error-text">
        <Setter Property="Foreground"
                Value="{StaticResource MetadataFailedBrush}" />
    </Style>

    <Style Selector="TextBlock.metadata-label">
        <Setter Property="Foreground"
                Value="{StaticResource MetadataSecondaryTextBrush}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.metadata-model,
                     TextBlock.metadata-value,
                     TextBlock.metadata-heading">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource MetadataTextBrush}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.metadata-model">
        <Setter Property="FontSize"
                Value="20" />
    </Style>

    <Style Selector="Border.metadata-specs">
        <Setter Property="Padding"
                Value="0,12" />
        <Setter Property="BorderBrush"
                Value="{StaticResource MetadataDividerBrush}" />
        <Setter Property="BorderThickness"
                Value="0,1" />
    </Style>

    <Style Selector="TextBox.metadata-text">
        <Setter Property="Padding"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="VerticalContentAlignment"
                Value="Top" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="CaretBrush"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource MetadataPromptTextBrush}" />
        <Setter Property="LineHeight"
                Value="21" />
    </Style>

    <Style Selector="Path.metadata-outline-icon">
        <Setter Property="Width"
                Value="{StaticResource MetadataIconSize}" />
        <Setter Property="Height"
                Value="{StaticResource MetadataIconSize}" />
        <Setter Property="Stretch"
                Value="Uniform" />
        <Setter Property="StrokeThickness"
                Value="1.6" />
        <Setter Property="StrokeLineCap"
                Value="Round" />
        <Setter Property="StrokeJoin"
                Value="Round" />
    </Style>

    <Style Selector="Button Path.metadata-outline-icon">
        <Setter Property="Stroke"
                Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <Style Selector="Panel.metadata-reuse-host:not(.with-references)">
        <Setter Property="Grid.RowSpan"
                Value="2" />
        <Setter Property="VerticalAlignment"
                Value="Bottom" />
    </Style>

    <Style Selector="Panel.metadata-reuse-host.with-references">
        <Setter Property="Grid.Row"
                Value="1" />
        <Setter Property="MinHeight"
                Value="{StaticResource AttachmentItemSize}" />
        <Setter Property="VerticalAlignment"
                Value="Top" />
    </Style>

    <Style Selector="Button.metadata-repeat">
        <Setter Property="MinHeight"
                Value="39" />
        <Setter Property="Padding"
                Value="18,7" />
        <Setter Property="Background"
                Value="{StaticResource MetadataRepeatBrush}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="CornerRadius"
                Value="7" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource MetadataRepeatTextBrush}" />
    </Style>

    <Style Selector="Button.metadata-repeat:pointerover:not(:disabled)">
        <Setter Property="Background"
                Value="{StaticResource MetadataRepeatHoverBrush}" />
    </Style>
</Styles>
