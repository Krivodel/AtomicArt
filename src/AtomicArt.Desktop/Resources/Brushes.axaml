<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:resources="using:AtomicArt.Desktop.Resources">
    <BoxShadows x:Key="FloatingSurfaceShadow">0 18 42 0 #80000000</BoxShadows>
    <LinearGradientBrush x:Key="ContextMenuBackgroundBrush"
                         EndPoint="100%,100%"
                         StartPoint="0%,0%">
        <GradientStop Color="{StaticResource ContextMenuGradientStartColor}"
                      Offset="0" />
        <GradientStop Color="{StaticResource ContextMenuGradientEndColor}"
                      Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassCardBrush"
                     Color="{DynamicResource SukiGlassCardBackground}"
                     Opacity="{DynamicResource GlassOpacity}" />
    <SolidColorBrush x:Key="GalleryHighlightBackgroundBrush"
                     Color="{x:Static resources:GalleryHighlightPalette.BackgroundColor}" />
    <SolidColorBrush x:Key="GalleryHighlightBorderBrush"
                     Color="{x:Static resources:GalleryHighlightPalette.BorderColor}" />
    <SolidColorBrush x:Key="GalleryUnselectedCardDimBrush"
                     Color="{StaticResource GallerySelectionTintColor}"
                     Opacity="{StaticResource GalleryUnselectedCardDimOpacity}" />
    <SolidColorBrush x:Key="ModalOverlayTintBrush"
                     Color="{DynamicResource SukiPopupBackground}"
                     Opacity="{DynamicResource ModalOverlayTintOpacity}" />
    <SolidColorBrush x:Key="MetadataBorderBrush"
                     Color="{DynamicResource SukiMenuBorderBrush}"
                     Opacity="0.5" />
    <SolidColorBrush x:Key="MetadataMutedTextBrush"
                     Color="{DynamicResource SukiText}"
                     Opacity="0.62" />
</ResourceDictionary>
