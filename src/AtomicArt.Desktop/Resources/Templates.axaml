<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:galleryViews="using:AtomicArt.Desktop.Views.Gallery"
        xmlns:resources="using:AtomicArt.Desktop.Resources"
        xmlns:suki="using:SukiUI.Controls"
        xmlns:sukiAnimations="using:SukiUI.Animations"
        xmlns:sukiGlass="using:SukiUI.Controls.GlassMorphism">
    <Style Selector="suki|SukiDialogHost.confirmation-dialog-host /template/ ContentControl#PART_DialogContent">
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <ThicknessTransition Duration="{StaticResource ConfirmationDialogTransitionDuration}"
                                         Property="Margin">
                        <ThicknessTransition.Easing>
                            <sukiAnimations:SukiEaseOutBack />
                        </ThicknessTransition.Easing>
                    </ThicknessTransition>
                    <DoubleTransition Duration="{StaticResource ConfirmationDialogOpacityTransitionDuration}"
                                      Property="Opacity" />
                    <TransformOperationsTransition Duration="{StaticResource ConfirmationDialogTransitionDuration}"
                                                   Property="RenderTransform">
                        <TransformOperationsTransition.Easing>
                            <sukiAnimations:SukiEaseOutBack BounceIntensity="Strong" />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="suki|SukiDialog.confirmation-dialog /template/ suki|GlassCard /template/ Border.GlassCardBorderPartCard">
        <Setter Property="Background"
                Value="{DynamicResource SukiPopupBackground}" />
        <Setter Property="Opacity"
                Value="1" />
    </Style>

    <Style Selector="suki|SukiDialog.confirmation-dialog /template/ sukiGlass|SukiBlurBackground">
        <Setter Property="IsVisible"
                Value="False" />
    </Style>

    <Style Selector="Border.generation-panel">
        <Setter Property="Padding"
                Value="{StaticResource GenerationPanelPadding}" />
        <Setter Property="Background"
                Value="{DynamicResource GlassCardBrush}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource ShellCornerRadius}" />
    </Style>

    <Style Selector="Border.generation-panel-content">
        <Setter Property="Opacity"
                Value="1" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Duration="{StaticResource TransientOverlayFadeDuration}"
                                      Easing="{StaticResource TransientOverlayEasing}"
                                      Property="Opacity" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.generation-panel-content.selection-mode">
        <Setter Property="Opacity"
                Value="0" />
    </Style>

    <Style Selector=":is(Border).modal-glass-panel">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Background"
                Value="{DynamicResource SukiPopupBackground}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource SukiMenuBorderBrush}" />
        <Setter Property="BoxShadow"
                Value="{DynamicResource SukiPopupShadow}" />
        <Setter Property="ClipToBounds"
                Value="True" />
    </Style>

    <Style Selector="Border.attachment-preview">
        <Setter Property="Width"
                Value="{StaticResource AttachmentItemSize}" />
        <Setter Property="Height"
                Value="{StaticResource AttachmentItemSize}" />
        <Setter Property="Margin"
                Value="{StaticResource AttachmentPreviewMargin}" />
        <Setter Property="Background"
                Value="{DynamicResource GlassCardBrush}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="ClipToBounds"
                Value="True" />
        <Setter Property="CornerRadius"
                Value="{StaticResource AttachmentPreviewCornerRadius}" />
    </Style>

    <Style Selector="Border.generation-card-container">
        <Setter Property="Width"
                Value="{StaticResource GenerationCardWidth}" />
        <Setter Property="Height"
                Value="{StaticResource GenerationCardHeight}" />
        <Setter Property="Margin"
                Value="{StaticResource GalleryCardMargin}" />
        <Setter Property="Padding"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="ClipToBounds"
                Value="False" />
        <Setter Property="CornerRadius"
                Value="{StaticResource GenerationCardCornerRadius}" />
    </Style>

    <Style Selector="Border.generation-card">
        <Setter Property="Padding"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="Background"
                Value="{DynamicResource GlassCardBrush}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource ZeroThickness}" />
        <Setter Property="ClipToBounds"
                Value="True" />
        <Setter Property="CornerRadius"
                Value="{StaticResource GenerationCardCornerRadius}" />
    </Style>

    <Style Selector="Border.gallery-selection-dimming-overlay">
        <Setter Property="Background"
                Value="{StaticResource GalleryUnselectedCardDimBrush}" />
        <Setter Property="IsHitTestVisible"
                Value="False" />
        <Setter Property="Opacity"
                Value="0" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{StaticResource GenerationCardVisualStateTransitionDuration}" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="galleryViews|GenerationCardControl:selection-dimmed Border.gallery-selection-dimming-overlay">
        <Setter Property="Opacity"
                Value="1" />
    </Style>

    <Style Selector="Border.gallery-selection-highlight">
        <Setter Property="Background"
                Value="{StaticResource GalleryHighlightBackgroundBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource GalleryHighlightBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="{x:Static resources:GalleryHighlightPalette.BorderThickness}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource GenerationCardCornerRadius}" />
        <Setter Property="IsHitTestVisible"
                Value="False" />
        <Setter Property="Opacity"
                Value="0" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{StaticResource GenerationCardVisualStateTransitionDuration}" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.gallery-selection-highlight.selected">
        <Setter Property="Opacity"
                Value="1" />
    </Style>

    <Style Selector="Path.gallery-selection-check">
        <Setter Property="Width"
                Value="{StaticResource GenerationCardActionIconSize}" />
        <Setter Property="Height"
                Value="{StaticResource GenerationCardActionIconSize}" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Data"
                Value="{StaticResource GallerySelectionCheckIcon}" />
        <Setter Property="Stretch"
                Value="None" />
        <Setter Property="Stroke"
                Value="{DynamicResource SukiText}" />
        <Setter Property="StrokeLineCap"
                Value="Round" />
        <Setter Property="StrokeJoin"
                Value="Round" />
        <Setter Property="StrokeThickness"
                Value="{StaticResource GallerySelectionCheckStrokeThickness}" />
        <Setter Property="Effect">
            <DropShadowEffect BlurRadius="{StaticResource GallerySelectionShadowBlurRadius}"
                              Color="{StaticResource GallerySelectionTintColor}"
                              OffsetX="0"
                              OffsetY="{StaticResource GallerySelectionShadowOffsetY}"
                              Opacity="{StaticResource GallerySelectionShadowOpacity}" />
        </Setter>
    </Style>

    <Style Selector="Border.image-preview-shadow">
        <Setter Property="BoxShadow"
                Value="{DynamicResource FloatingSurfaceShadow}" />
    </Style>

    <Style Selector="Border.generation-card-preview">
        <Setter Property="Background"
                Value="{DynamicResource GlassCardBrush}" />
        <Setter Property="ClipToBounds"
                Value="True" />
    </Style>

    <Style Selector="Border.generation-card-empty">
        <Setter Property="Background"
                Value="{DynamicResource GlassCardBrush}" />
    </Style>

    <Style Selector="Border.generation-card-error">
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Stretch" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource SukiDangerColor}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style Selector="Border.generation-card-info">
        <Setter Property="Padding"
                Value="{StaticResource GalleryCardInfoPadding}" />
        <Setter Property="Background"
                Value="{DynamicResource GlassCardBrush}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource GenerationCardInfoCornerRadius}" />
    </Style>

    <Style Selector="Image.generation-card-image">
        <Setter Property="Stretch"
                Value="UniformToFill" />
    </Style>

    <Style Selector="Path.metadata-outline-icon">
        <Setter Property="Width"
                Value="{StaticResource MetadataIconSize}" />
        <Setter Property="Height"
                Value="{StaticResource MetadataIconSize}" />
        <Setter Property="Stretch"
                Value="Uniform" />
        <Setter Property="Stroke"
                Value="{DynamicResource SukiText}" />
        <Setter Property="StrokeThickness"
                Value="2" />
        <Setter Property="StrokeLineCap"
                Value="Round" />
        <Setter Property="StrokeJoin"
                Value="Round" />
    </Style>

    <Style Selector="Border.metadata-chip">
        <Setter Property="Height"
                Value="{StaticResource MetadataChipHeight}" />
        <Setter Property="Padding"
                Value="{StaticResource MetadataChipPadding}" />
        <Setter Property="Background"
                Value="{DynamicResource GlassCardBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource MetadataBorderBrush}" />
        <Setter Property="BorderThickness"
                Value="{StaticResource ShellBorderThickness}" />
        <Setter Property="CornerRadius"
                Value="{StaticResource MetadataChipCornerRadius}" />
    </Style>

    <Style Selector="Border.metadata-status">
        <Setter Property="Height"
                Value="{StaticResource MetadataStatusHeight}" />
        <Setter Property="Padding"
                Value="{StaticResource MetadataStatusPadding}" />
        <Setter Property="HorizontalAlignment"
                Value="Left" />
        <Setter Property="VerticalAlignment"
                Value="Top" />
    </Style>
</Styles>
